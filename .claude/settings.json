{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Edit(spec/**)",
      "Edit(internal/**)",
      "Edit(themes/**)",
      "Edit(content_types/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(docker:*)",
      "Edit(config/roles.json)",
      "Edit(go.mod)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sqlite3:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/log-tool.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gofmt-check.sh"
          }
        ]
      }
    ]
  }
}
